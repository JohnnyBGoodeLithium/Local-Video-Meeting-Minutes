# 复制到目标机器后修改。不要在此文件放 token、密码或真实会议路径。
MEETING_DATA_ROOT=/srv/meeting-minutes-data
MEETING_WEB_BANK=/srv/meeting-minutes-data/speaker_bank
MEETING_WEB_JOBS=/srv/meeting-minutes-data/jobs
MEETING_PYTHON=/opt/meeting-minutes/.venv/bin/python
MEETING_WEB_PORT=8899

MEETING_DEVICE=auto
MEETING_TORCH_DTYPE=auto
MEETING_ASR_MODEL=/opt/models/Qwen3-ASR-1.7B
MEETING_ALIGNER_MODEL=/opt/models/Qwen3-ForcedAligner-0.6B
MEETING_PYANNOTE_MODEL=/opt/models/speaker-diarization-community-1

MEETING_LLM_API=http://127.0.0.1:11435/v1
MEETING_LLM_MODEL=qwen3.6-35b-a3b-operator
MEETING_LLM_CONTEXT_SIZE=65536

MEETING_VL_MODEL=/opt/models/MiMo-VL-Miloco-7B_Q4_0.gguf
MEETING_VL_MMPROJ=/opt/models/mmproj-MiMo-VL-Miloco-7B_BF16.gguf
MEETING_VL_PORT=11436
MEETING_VL_GPU_LAYERS=999
