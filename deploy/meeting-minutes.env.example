# 复制到目标机器后修改。不要在此文件放 token、密码或真实会议路径。
MEETING_DATA_ROOT=/srv/meeting-minutes-data
MEETING_WEB_BANK=/srv/meeting-minutes-data/speaker_bank
MEETING_WEB_JOBS=/srv/meeting-minutes-data/jobs
MEETING_PYTHON=/opt/meeting-minutes/.venv/bin/python
MEETING_WEB_PORT=8899

MEETING_DEVICE=auto
MEETING_TORCH_DTYPE=auto
# ASR 默认走进程内本地适配器。也可显式设为 openai-compatible，连接本机、局域网或
# 经公司批准的云端 /audio/transcriptions；系统不会自行把内部音频切到远端。
MEETING_ASR_PROVIDER=native
MEETING_ASR_MODEL=/opt/models/Qwen3-ASR-1.7B
MEETING_ALIGNER_MODEL=/opt/models/Qwen3-ForcedAligner-0.6B
# MEETING_ASR_API=http://127.0.0.1:11439/v1
# MEETING_ASR_API_MODEL=whisper-1
# MEETING_ASR_API_KEY=
# auto=端点拒绝 prompt 时自动去掉 context 重试；required=不允许该降级；off=不发送。
MEETING_ASR_CONTEXT_MODE=auto
# 只有显式填写才允许 provider 故障切换，例如 primary=openai-compatible、fallback=native。
MEETING_ASR_FALLBACK_PROVIDER=
# 术语混淆音频定点复核属于增强层，失败不阻断基础逐字稿。
MEETING_ASR_REVIEW=1
MEETING_PYANNOTE_MODEL=/opt/models/speaker-diarization-community-1

MEETING_LLM_API=http://127.0.0.1:11435/v1
MEETING_LLM_MODEL=qwen3.6-35b-a3b-operator
MEETING_DRAFT_MODEL=qwen3.6-35b-a3b-operator
MEETING_MINUTES_MODEL=qwen3.8-27b-minutes
MEETING_RECOVERY_REFINE_MODEL=gpt-oss-120b
MEETING_LLM_CONTEXT_SIZE=65536

# 统一内存护栏：健康时允许两个文本模型；重型音频/视觉阶段自动收缩为一个。
# 可用内存低于 stop 时等待而不是继续抢内存；低于 emergency 时强制卸载模型保护整机。
MEETING_MEMORY_RESERVE_GIB=32
MEETING_MEMORY_STOP_GIB=24
MEETING_MEMORY_EMERGENCY_GIB=8
MEETING_RESOURCE_WAIT_SECONDS=900
MEETING_RESOURCE_POLL_SECONDS=2
MEETING_HEALTHY_TEXT_MODELS=2
# 仅测试/诊断隔离环境可设 0；生产默认必须保持 1。
MEETING_RESOURCE_GUARD=1

# 可选知识库入口。URL 会显示在工作台顶栏；局域网使用时不能填写 127.0.0.1。
MEETING_KB_PROVIDER=weknora
MEETING_KB_URL=http://127.0.0.1:8088
MEETING_KB_HEALTH_URL=http://127.0.0.1:8080/health

MEETING_VL_MODEL=/opt/models/MiMo-VL-Miloco-7B_Q4_0.gguf
MEETING_VL_MMPROJ=/opt/models/mmproj-MiMo-VL-Miloco-7B_BF16.gguf
MEETING_VL_PORT=11436
MEETING_VL_GPU_LAYERS=999
# 可选：仅复核媒体视频中自动识别出的复杂表格/图表/跑分/疑难 OCR 页。
# 留空即全部保留主力 VL 结果；失败不会阻断纪要。
MEETING_VL_REVIEW_MODEL=
MEETING_VL_REVIEW_MMPROJ=
MEETING_VL_REVIEW_PORT=11437
MEETING_VL_REVIEW_MAX_PAGES=12
